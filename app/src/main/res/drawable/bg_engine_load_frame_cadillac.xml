<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/cadillac_label_blue" />
            <corners android:radius="5dp" />
        </shape>
    </item>
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#484848" />
            <corners android:radius="3dp" />
        </shape>
    </item>
    <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#161616" android:centerColor="#292929" android:endColor="#101010" />
            <corners android:radius="1dp" />
        </shape>
    </item>
</layer-list>
