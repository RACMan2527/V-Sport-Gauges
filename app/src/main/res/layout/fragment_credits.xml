<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="top">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="V-Sport Gauges"
                    android:textStyle="bold"
                    android:textSize="21sp"/>
                <TextView
                    android:id="@+id/txtVersion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Cadillac-inspired performance instrumentation for Android Auto."
                    android:textSize="14sp"/>
            </LinearLayout>
            <ImageView
                android:layout_width="100dp"
                android:layout_height="80dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/cadillac_v_series"
                android:scaleType="fitCenter"
                android:contentDescription="Cadillac V-Series logo"/>
        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Created for the 2023 Cadillac Escalade Sport Platinum, featuring configurable gauges, live vehicle data, and peak tracking."
            android:textSize="14sp"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Project development"
            android:textStyle="bold"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="RACMan2527 — Concept, customization, requirements, and vehicle testing, with AI-assisted software development."
            android:textSize="14sp"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Original development"
            android:textStyle="bold"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Kevin Agronick — AA Torque&#10;Chillout — Original application foundation&#10;Martoreto — SDK and demo application"
            android:textSize="14sp"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">
            <Button android:id="@+id/githubBtn"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:minWidth="0dp"
                android:text="GitHub" android:textAllCaps="false" android:textSize="12sp"/>
            <Button android:id="@+id/releasesBtn"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:minWidth="0dp"
                android:text="Releases" android:textAllCaps="false" android:textSize="12sp"/>
            <Button android:id="@+id/historyBtn"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:minWidth="0dp"
                android:text="History" android:textAllCaps="false" android:textSize="12sp"/>
        </LinearLayout>
        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="Additional contributors"
            android:textStyle="bold"/>
        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="mkwatchface, Ddemtlapps, Hugo Morais, Jose Alberto Morales Nery, kacnje, Mirco, Paul Rusu, tasos-kom, Vasyl Solevych, Vincent chouquet, Vladi69"
            android:textSize="12sp"/>
        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="@string/icon_credits"
            android:textStyle="bold"/>
        <LinearLayout
            android:id="@+id/ic_credits_list"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical"/>
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:orientation="horizontal">
            <Button android:id="@+id/donateBtn"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:minWidth="0dp"
                android:text="Support AA Torque" android:textAllCaps="false" android:textSize="12sp"/>
            <Button android:id="@+id/translateBtn"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:minWidth="0dp"
                android:text="Translate upstream" android:textAllCaps="false" android:textSize="12sp"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
